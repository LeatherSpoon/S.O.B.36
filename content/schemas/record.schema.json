{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S.O.B.36 content record v1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "pack_id",
    "type",
    "status",
    "source_ref",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+$"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+$"
    },
    "type": {
      "enum": [
        "Campaign",
        "Party",
        "Hero",
        "HeroClass",
        "Ability",
        "Item",
        "Card",
        "Enemy",
        "EnemyGroup",
        "Encounter",
        "Threat",
        "Mission",
        "World",
        "Location",
        "Town",
        "TownLocation",
        "MapTile",
        "MapSpace",
        "MapConnection",
        "Deck",
        "StatusEffect",
        "ExpansionPack"
      ]
    },
    "status": {
      "enum": [
        "imported",
        "identified",
        "verified"
      ]
    },
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "data": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "Enemy"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "hp",
              "xp"
            ],
            "additionalProperties": false,
            "properties": {
              "hp": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "xp": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "MapTile"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "spaces",
              "connections"
            ],
            "additionalProperties": false,
            "properties": {
              "spaces": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "tile",
                    "x",
                    "y"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9._-]+$"
                    },
                    "tile": {
                      "type": "string",
                      "pattern": "^[a-z0-9._-]+$"
                    },
                    "x": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 20
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 20
                    }
                  }
                }
              },
              "connections": {
                "type": "array",
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9._-]+$"
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$comment": "Runtime also enforces record id starts with pack_id + '.', unique space IDs, and non-self connections. Enemy and MapTile payloads are Phase 0 fixtures, not tabletop schemas."
}
